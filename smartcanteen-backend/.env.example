# Hosted DEMO only: use a separate database with test users/orders.
NODE_ENV=staging
MONGO_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
CLIENT_URL=https://YOUR-FRONTEND.vercel.app
ENABLE_DEMO_PAYMENTS=true
PAYHERE_SANDBOX=true
# Leave PayHere credentials unset for the built-in simulated payment flow.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_NOTIFY_URL=
PAYHERE_BASE_URL=
# Hosting supplies PORT. For local use:
PORT=5000
